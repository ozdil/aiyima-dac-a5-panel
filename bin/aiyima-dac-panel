#!/usr/bin/env python3
import faulthandler
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

# Hata ve donma teşhisi: ~/.cache/aiyima-dac-panel/panel.log
log_dir = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "aiyima-dac-panel")
os.makedirs(log_dir, exist_ok=True)
log = open(os.path.join(log_dir, "panel.log"), "a", buffering=1)
faulthandler.enable(log)
sys.stderr = log

from aiyima_panel.app import main  # noqa: E402

sys.exit(main(watchdog_file=log))
